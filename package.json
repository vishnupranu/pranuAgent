{
  "name": "gsc-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-device workspace for planning, designing, and drafting software projects.",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:dist": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.gsc.studio",
    "productName": "GSC Studio",
    "directories": { "output": "release" },
    "files": ["index.html", "studio.css", "studio.js", "mark.svg", "manifest.webmanifest", "sw.js", "electron/**/*"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
